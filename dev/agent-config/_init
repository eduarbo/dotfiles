#!/usr/bin/env zsh
source ${0:A:h}/../../deploy
source ${0:A:h}/../../macos/workstation/profile.zsh

deps=(shell/git)
os=(macos debian)

_ensure_gh() {
  if _is_callable gh; then
    return 0
  fi

  case $(_os) in
    macos)
      brew install gh
      ;;
    debian)
      sudo apt update && sudo apt install -y gh
      ;;
  esac
}

_github_account_id() {
  local username="$1"
  local accounts_root metadata configured_username

  accounts_root=${GITHUB_ACCOUNTS_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/github-accounts}
  for metadata in "$accounts_root"/accounts/account-*.gitconfig(N); do
    configured_username=$(git config -f "$metadata" --get account.username 2>/dev/null) || continue
    if [[ "$configured_username" == "$username" ]]; then
      print -r -- "${metadata:t:r}"
      return 0
    fi
  done
  return 1
}

_github_token() {
  local account="$1" account_id token

  if account_id=$(_github_account_id "$account") && _is_callable git-account; then
    token=$(git account gh "$account_id" -- auth token --hostname github.com 2>/dev/null) || true
    if [[ -n "$token" ]]; then
      print -r -- "$token"
      return 0
    fi
  fi
  gh auth token --hostname github.com --user "$account" 2>/dev/null
}

_git_with_token() {
  local account="$1"
  shift
  local token
  token=$(_github_token "$account") || {
    echo-alert "GitHub account '$account' is not authenticated in gh."
    echo-note "Run: gh auth login --hostname github.com"
    return 1
  }

  GH_TOKEN="$token" GIT_TERMINAL_PROMPT=0 \
    git -c credential.helper= \
        -c 'credential.helper=!gh auth git-credential' \
        "$@"
}

_clone_repo() {
  local account="$1" repository="$2" destination="$3"

  [[ -d "$destination/.git" ]] && return 0
  if [[ -e "$destination" ]]; then
    echo-alert "Refusing to replace existing path: $destination"
    return 1
  fi

  mkdir -p "${destination:h}"
  echo-note "Cloning $repository"
  _git_with_token "$account" clone --origin origin \
    "https://github.com/$repository.git" "$destination"
}

_repo_exists() {
  local account="$1" repository="$2" token
  token=$(_github_token "$account") || return 1
  GH_TOKEN="$token" gh repo view "$repository" \
    --json nameWithOwner >/dev/null 2>&1
}

_route_repo_account() {
  local account="$1" repository_dir="$2" account_id

  [[ -d "$repository_dir/.git" ]] || return 0
  _is_callable git-account || return 0
  account_id=$(_github_account_id "$account") || return 0
  git -C "$repository_dir" account use "$account_id" origin
}

_update_repo() {
  local account="$1" repository_dir="$2" remote_url

  [[ -d "$repository_dir/.git" ]] || return 0
  if [[ -n "$(git -C "$repository_dir" status --porcelain)" ]]; then
    echo-alert "Skipping update for dirty checkout: $repository_dir"
    return 0
  fi
  if ! git -C "$repository_dir" rev-parse --verify '@{upstream}' >/dev/null 2>&1; then
    echo-alert "Skipping update without upstream: $repository_dir"
    return 0
  fi

  remote_url=$(git -C "$repository_dir" remote get-url origin 2>/dev/null) || return 1
  case "$remote_url" in
    https://github.com/*) _git_with_token "$account" -C "$repository_dir" pull --ff-only ;;
    *) git -C "$repository_dir" pull --ff-only ;;
  esac
}

_orchestrate_agent_config() {
  local operation="$1"
  local account global_repository owner_repository
  local global_dir owner_dir

  _ensure_gh || return $?

  account=${AGENT_CONFIG_ACCOUNT:-$WORKSTATION_REPOSITORY_OWNER}
  [[ -n "$account" ]] || {
    echo-alert "The workstation repository owner is not configured."
    echo-note "Set WORKSTATION_REPOSITORY_OWNER or AGENT_CONFIG_ACCOUNT and rerun."
    return 1
  }

  global_repository=${AGENT_CONFIG_GLOBAL_REPO:-$WORKSTATION_AGENT_CONFIG_GLOBAL_REPOSITORY}
  owner_repository=${AGENT_CONFIG_OWNER_REPO:-$WORKSTATION_AGENT_CONFIG_OWNER_REPOSITORY}
  global_dir=${AGENT_CONFIG_GLOBAL_DIR:-$HOME/dev/$account/agent-config-global}
  owner_dir=${AGENT_CONFIG_OWNER_DIR:-$HOME/dev/$account/agent-config}

  _clone_repo "$account" "$global_repository" "$global_dir" || return $?
  _route_repo_account "$account" "$global_dir" || return $?
  if _repo_exists "$account" "$owner_repository"; then
    _clone_repo "$account" "$owner_repository" "$owner_dir" || return $?
    _route_repo_account "$account" "$owner_dir" || return $?
  fi

  if [[ "$operation" == update ]]; then
    _update_repo "$account" "$global_dir" || return $?
    _update_repo "$account" "$owner_dir" || return $?
  fi

  AGENT_WORKSPACES_DIR="${AGENT_WORKSPACES_DIR:-$HOME/dev}" \
    "$global_dir/setup" || return $?

  [[ -x "$global_dir/bin/agent-config" ]] || {
    echo-alert "agent-config command is missing from $global_dir"
    return 1
  }
  "$global_dir/bin/agent-config" track add "$DOTFILES" || return $?
  AGENT_WORKSPACES_DIR="${AGENT_WORKSPACES_DIR:-$HOME/dev}" \
    "$global_dir/bin/agent-config" monitor install || return $?
  AGENT_WORKSPACES_DIR="${AGENT_WORKSPACES_DIR:-$HOME/dev}" \
    "$global_dir/bin/agent-config" doctor --managed-only || return $?
  AGENT_WORKSPACES_DIR="${AGENT_WORKSPACES_DIR:-$HOME/dev}" \
    "$global_dir/bin/agent-config" doctor --offline || \
    echo-note "Tracked workflow changes need attention; the daily monitor is active."
  return 0
}

link() {
  return 0
}

install() {
  _orchestrate_agent_config install
}

update() {
  _orchestrate_agent_config update
}

clean() {
  if [[ -x "$HOME/.local/bin/agent-config" ]]; then
    "$HOME/.local/bin/agent-config" monitor uninstall || return $?
  fi
  echo-note "Agent configuration repositories and symlinks were preserved."
}

init "$@"
