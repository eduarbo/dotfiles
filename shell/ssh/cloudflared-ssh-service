#!/usr/bin/env zsh
set -euo pipefail

readonly hostname="${1:?usage: cloudflared-ssh-service HOSTNAME}"
readonly account="${USER:-$(id -un)}"
readonly config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
readonly service_config="$config_home/ssh/cloudflared-service.conf"

cloudflared_bin="$(command -v cloudflared 2>/dev/null || true)"
for candidate in /opt/homebrew/bin/cloudflared /usr/local/bin/cloudflared; do
  [[ -n "$cloudflared_bin" ]] && break
  [[ -x "$candidate" ]] && cloudflared_bin="$candidate"
done
[[ -n "$cloudflared_bin" ]] || {
  print -u2 "cloudflared is not installed"
  exit 127
}
readonly cloudflared_bin

# A local prefix keeps private host or organization names out of this repository.
keychain_prefix=
if [[ -r "$service_config" ]]; then
  keychain_prefix="$(sed -n 's/^keychain_service_prefix=//p' "$service_config" | sed -n '1p')"
fi

# If the local Keychain entries are absent, preserve interactive browser login.
if [[ -n "$keychain_prefix" ]] \
  && command -v security >/dev/null 2>&1 \
  && client_id="$(security find-generic-password \
    -a "$account" -s "${keychain_prefix}-client-id" -w 2>/dev/null)" \
  && client_secret="$(security find-generic-password \
    -a "$account" -s "${keychain_prefix}-client-secret" -w 2>/dev/null)"; then
  exec "$cloudflared_bin" access tcp \
    --hostname "$hostname" \
    --service-token-id "$client_id" \
    --service-token-secret "$client_secret"
fi

exec "$cloudflared_bin" access ssh --hostname "$hostname"
