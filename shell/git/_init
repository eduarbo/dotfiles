#!/usr/bin/env zsh
source ${0:A:h}/../../deploy
GIT_DIR="$XDG_CONFIG_HOME/git"

os=(macos debian)

# Dependencies

common_deps=(
  git
  git-delta  # better diff viewer (replaces diff-so-fancy)
  gh
  gitleaks
)

apt_deps=(
  git
  git-delta
  gh
  gitleaks
)

_ensure_local_config() {
  mkdir -p "$GIT_DIR"
  [[ -e "$GIT_DIR/local.gitconfig" ]] || touch "$GIT_DIR/local.gitconfig"
  chmod 600 "$GIT_DIR/local.gitconfig"
}

link() {
  _ensure_local_config
  mkdir -p "$GIT_DIR/hooks"
  mklink {config,ignore,message} "$GIT_DIR/"
  mklink hooks/pre-push "$GIT_DIR/hooks/"
}

install() {
  case $(_os) in
    macos)
      brew install ${common_deps[@]}
      # to sign commits
      brew install gpg-suite
      ;;
    debian)
      sudo apt update && sudo apt install -y ${apt_deps[@]}
      ;;
  esac

  # Kill zcompdump to take new compdefs
  rm -f "${ZINIT[ZCOMPDUMP_PATH]}"
  rm -f "${ZINIT[ZCOMPDUMP_PATH]}.zwc"
}

update() {
  _ensure_local_config
  case $(_os) in
    macos)
      brew install ${common_deps[@]}
      brew upgrade ${common_deps[@]}
      ;;
    debian)
      sudo apt update && sudo apt install -y ${apt_deps[@]}
      ;;
  esac
}

clean() {
  rm -fv \
    "$GIT_DIR/config" \
    "$GIT_DIR/ignore" \
    "$GIT_DIR/message" \
    "$GIT_DIR/hooks/pre-push"
  echo-note "Local Git identity and GitHub account data were preserved."
}

init "$@"
