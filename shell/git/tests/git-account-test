#!/bin/sh
set -eu

unset CDPATH
ROOT=$(cd -- "$(dirname "$0")/../../.." && pwd)
PROGRAM="$ROOT/shell/git/bin/git-account"
TEST_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/git-account-unit.XXXXXX")
trap 'rm -rf "$TEST_ROOT"' EXIT HUP INT TERM

export HOME="$TEST_ROOT/home"
export XDG_CONFIG_HOME="$HOME/.config"
export GITHUB_ACCOUNTS_DIR="$XDG_CONFIG_HOME/github-accounts"
export GIT_CONFIG_NOSYSTEM=1
export GIT_CONFIG_GLOBAL="$ROOT/shell/git/config"

"$ROOT/deploy" -l shell/git shell/ssh >/dev/null
[ -L "$XDG_CONFIG_HOME/git/config" ]
[ -L "$XDG_CONFIG_HOME/git/hooks/pre-push" ]
[ -L "$HOME/.ssh/config" ]
[ -f "$XDG_CONFIG_HOME/git/local.gitconfig" ]
[ -f "$XDG_CONFIG_HOME/ssh/local.conf" ]

ssh-keygen -q -t ed25519 -N '' -C 'must-not-survive' -f "$TEST_ROOT/key"

"$PROGRAM" add account-1 \
  --auth-key "$TEST_ROOT/key.pub" \
  --username example-user \
  --name 'Example User' \
  --email example@example.invalid \
  --no-sign \
  --no-infer

[ "$(awk '{print NF}' "$GITHUB_ACCOUNTS_DIR/keys/account-1-auth.pub")" -eq 2 ]
if grep -q 'must-not-survive' "$GITHUB_ACCOUNTS_DIR/keys/account-1-auth.pub"; then
  printf 'public key comment was retained\n' >&2
  exit 1
fi

before=$(cksum \
  "$GITHUB_ACCOUNTS_DIR/ssh/config" \
  "$GITHUB_ACCOUNTS_DIR/git/includes.gitconfig")
"$PROGRAM" render >/dev/null
after=$(cksum \
  "$GITHUB_ACCOUNTS_DIR/ssh/config" \
  "$GITHUB_ACCOUNTS_DIR/git/includes.gitconfig")
[ "$before" = "$after" ]

repo="$TEST_ROOT/repo"
mkdir -p "$repo"
git -C "$repo" init -q
git -C "$repo" remote add origin https://github.com/example/example.git
(
  cd "$repo"
  "$PROGRAM" use account-1 >/dev/null
  "$PROGRAM" use account-1 >/dev/null
)

[ "$(git -C "$repo" remote get-url origin)" = 'git@github-account-1:example/example.git' ]
[ "$(git -C "$repo" config --get githubAccount.id)" = account-1 ]
[ "$(git -C "$repo" config --get user.name)" = 'Example User' ]
[ "$(git -C "$repo" config --get user.email)" = example@example.invalid ]
[ "$(git -C "$repo" config --get commit.gpgSign)" = false ]

hook_repo="$TEST_ROOT/hook-repo"
mkdir -p "$hook_repo"
git -C "$hook_repo" init -q
git -C "$hook_repo" config user.name 'Hook Test'
git -C "$hook_repo" config user.email hook@example.invalid
printf 'base\n' >"$hook_repo/state.txt"
git -C "$hook_repo" add state.txt
git -C "$hook_repo" commit -qm base
remote_oid=$(git -C "$hook_repo" rev-parse HEAD)
printf 'next\n' >>"$hook_repo/state.txt"
git -C "$hook_repo" commit -qam next
local_oid=$(git -C "$hook_repo" rev-parse HEAD)
git -C "$hook_repo" remote add origin https://github.com/example/hook-test.git

hook_mock_bin="$TEST_ROOT/hook-mock-bin"
mkdir -p "$hook_mock_bin"
printf '%s\n' \
  '#!/bin/sh' \
  'printf "%s\\n" "$*" >>"$GITLEAKS_TEST_LOG"' \
  '[ "${GITLEAKS_TEST_FAIL:-}" != 1 ]' >"$hook_mock_bin/gitleaks"
chmod 700 "$hook_mock_bin/gitleaks"
hook_log="$TEST_ROOT/gitleaks.log"
(
  cd "$hook_repo"
  printf 'refs/heads/main %s refs/heads/main %s\n' "$local_oid" "$remote_oid" | \
    GITLEAKS_TEST_LOG="$hook_log" PATH="$hook_mock_bin:$PATH" \
      "$XDG_CONFIG_HOME/git/hooks/pre-push" origin ignored
)
grep -Fq -- "--log-opts=$remote_oid..$local_oid" "$hook_log"
missing_remote_oid=1111111111111111111111111111111111111111
(
  cd "$hook_repo"
  printf 'refs/heads/main %s refs/heads/main %s\n' "$local_oid" "$missing_remote_oid" | \
    GITLEAKS_TEST_LOG="$hook_log" PATH="$hook_mock_bin:$PATH" \
      "$XDG_CONFIG_HOME/git/hooks/pre-push" origin ignored
)
tail -n 1 "$hook_log" | grep -Fq -- "--log-opts=$local_oid"
if (
  cd "$hook_repo"
  printf 'refs/heads/main %s refs/heads/main %s\n' "$local_oid" "$remote_oid" | \
    GITLEAKS_TEST_FAIL=1 GITLEAKS_TEST_LOG="$hook_log" PATH="$hook_mock_bin:$PATH" \
      "$XDG_CONFIG_HOME/git/hooks/pre-push" origin ignored >/dev/null 2>&1
); then
  printf 'pre-push allowed a failed secret scan\n' >&2
  exit 1
fi

mock_bin="$TEST_ROOT/mock-bin"
mkdir -p "$mock_bin"
# These literals are the source of the mock executable, so expansion is deferred.
# shellcheck disable=SC2016
printf '%s\n' \
  '#!/bin/sh' \
  'if [ "$1 $2" = "auth login" ]; then' \
  '  git config --global test.ghLoginSandbox true' \
  '  mkdir -p "$GH_CONFIG_DIR"' \
  '  : >"$GH_CONFIG_DIR/hosts.yml"' \
  'elif [ "$1 $2" = "auth token" ]; then' \
  '  printf "mock-token\\n"' \
  'elif [ "$1 $2" = "api user" ]; then' \
  '  [ "${FAIL_API:-}" != 1 ] || exit 99' \
  '  printf "example-user\\n"' \
  'elif [ "$1 $2" = "debug config-dir" ]; then' \
  '  printf "%s\\n" "$GH_CONFIG_DIR"' \
  'fi' >"$mock_bin/gh"
chmod 700 "$mock_bin/gh"
# shellcheck disable=SC2016
printf '%s\n' \
  '#!/bin/sh' \
  'if [ "$1" = "-L" ]; then' \
  '  sed -n "1p" "$TEST_PUBLIC_KEY"' \
  'fi' >"$mock_bin/ssh-add"
chmod 700 "$mock_bin/ssh-add"
PATH="$mock_bin:$PATH" "$PROGRAM" login account-1 >/dev/null
[ "$(git config -f "$GITHUB_ACCOUNTS_DIR/gh/account-1/gitconfig" --get test.ghLoginSandbox)" = true ]
[ -z "$(git config -f "$ROOT/shell/git/config" --get test.ghLoginSandbox || true)" ]

# A single failed diagnostic must be counted once, even though shell variables
# are global across POSIX functions.
mv "$GITHUB_ACCOUNTS_DIR/gh/account-1/hosts.yml" "$GITHUB_ACCOUNTS_DIR/gh/account-1/hosts.yml.disabled"
doctor_output=$(TEST_PUBLIC_KEY="$TEST_ROOT/key.pub" PATH="$mock_bin:$PATH" "$PROGRAM" doctor account-1 2>&1 || true)
printf '%s\n' "$doctor_output" | grep -q 'error: 1 diagnostic check(s) failed'
mv "$GITHUB_ACCOUNTS_DIR/gh/account-1/hosts.yml.disabled" "$GITHUB_ACCOUNTS_DIR/gh/account-1/hosts.yml"

identity=$(ssh -G github-account-1 2>/dev/null | awk '$1 == "identityfile" {print $2; exit}')
[ "$identity" = "$GITHUB_ACCOUNTS_DIR/keys/account-1-auth.pub" ]
[ "$(ssh -G github-account-1 2>/dev/null | awk '$1 == "identitiesonly" {print $2; exit}')" = yes ]
[ "$(ssh -G github.com 2>/dev/null | awk '$1 == "identityfile" {print $2; exit}')" = none ]

"$PROGRAM" add account-2 \
  --auth-key "$TEST_ROOT/key.pub" \
  --username example-user \
  --name 'Second Context' \
  --email second@example.invalid \
  --no-sign \
  --no-infer >/dev/null

[ "$(git config -f "$GITHUB_ACCOUNTS_DIR/accounts/account-2.gitconfig" --get account.ghMode)" = shared ]
[ "$(git config -f "$GITHUB_ACCOUNTS_DIR/accounts/account-2.gitconfig" --get account.ghAccount)" = account-1 ]
[ "$(PATH="$mock_bin:$PATH" "$PROGRAM" gh account-2 -- debug config-dir)" = \
  "$GITHUB_ACCOUNTS_DIR/gh/account-1" ]
PATH="$mock_bin:$PATH" "$PROGRAM" login account-2 >/dev/null
[ "$(git config -f "$GITHUB_ACCOUNTS_DIR/gh/account-1/gitconfig" --get test.ghLoginSandbox)" = true ]
[ ! -e "$GITHUB_ACCOUNTS_DIR/gh/account-2/gitconfig" ]
FAIL_API=1 TEST_PUBLIC_KEY="$TEST_ROOT/key.pub" PATH="$mock_bin:$PATH" \
  "$PROGRAM" doctor account-2 >/dev/null

repo2="$TEST_ROOT/repo2"
mkdir -p "$repo2"
git -C "$repo2" init -q
git -C "$repo2" remote add origin git@github-account-2:second/example.git
[ "$(git -C "$repo2" config --get githubAccount.id)" = account-2 ]
[ "$(git -C "$repo2" config --get user.name)" = 'Second Context' ]

gist="$TEST_ROOT/gist"
mkdir -p "$gist"
git -C "$gist" init -q
git -C "$gist" remote add origin git@github-account-2-gist:example.git
[ "$(git -C "$gist" config --get githubAccount.id)" = account-2 ]

git -C "$repo" remote add upstream git@github-account-2:second/example.git
[ "$(git -C "$repo" config --get-all githubAccount.id | sort -u | wc -l | tr -d ' ')" -eq 2 ]
git -C "$repo" remote remove upstream

"$PROGRAM" add account-3 \
  --auth-key "$TEST_ROOT/key.pub" \
  --username bot-user \
  --name 'Automation Identity' \
  --email bot@example.invalid \
  --no-sign \
  --no-gh \
  --no-infer >/dev/null
[ "$(git config -f "$GITHUB_ACCOUNTS_DIR/accounts/account-3.gitconfig" --get account.ghMode)" = none ]
TEST_PUBLIC_KEY="$TEST_ROOT/key.pub" PATH="$mock_bin:$PATH" "$PROGRAM" doctor account-3 >/dev/null
if PATH="$mock_bin:$PATH" "$PROGRAM" login account-3 >/dev/null 2>&1; then
  printf 'gh login was allowed for a profile with gh disabled\n' >&2
  exit 1
fi
if PATH="$mock_bin:$PATH" "$PROGRAM" gh account-3 -- status >/dev/null 2>&1; then
  printf 'gh command was allowed for a profile with gh disabled\n' >&2
  exit 1
fi
[ ! -e "$GITHUB_ACCOUNTS_DIR/gh/account-3/hosts.yml" ]

"$PROGRAM" add account-4 \
  --auth-key "$TEST_ROOT/key.pub" \
  --username client-user \
  --name 'Client Identity' \
  --email client@example.invalid \
  --no-sign \
  --no-infer >/dev/null
[ "$(git config -f "$GITHUB_ACCOUNTS_DIR/accounts/account-4.gitconfig" --get account.ghMode)" = isolated ]
if "$PROGRAM" add account-4 --share-gh account-1 >/dev/null 2>&1; then
  printf 'gh sharing was allowed across different GitHub logins\n' >&2
  exit 1
fi
[ "$(git config -f "$GITHUB_ACCOUNTS_DIR/accounts/account-4.gitconfig" --get account.ghMode)" = isolated ]

if find "$ROOT/shell/ssh" -maxdepth 1 -name '*.pub' -print | grep . >/dev/null; then
  printf 'versioned SSH public key found\n' >&2
  exit 1
fi
if grep -Eiq 'insteadOf[[:space:]]*=[[:space:]]*https://(gist\.)?github\.com|^[[:space:]]*(name|email|signingkey)[[:space:]]*=' "$ROOT/shell/git/config"; then
  printf 'global GitHub rewrite or identity found in the tracked Git config\n' >&2
  exit 1
fi

if "$PROGRAM" add account-personal \
  --auth-key "$TEST_ROOT/key.pub" \
  --username ignored --name ignored --email ignored@example.invalid \
  --no-sign --no-infer >/dev/null 2>&1; then
  printf 'invalid account ID was accepted\n' >&2
  exit 1
fi

printf '[test]\n\tvalue = preserved\n' >"$XDG_CONFIG_HOME/git/local.gitconfig"
printf 'Host test-only\n' >"$XDG_CONFIG_HOME/ssh/local.conf"
"$ROOT/deploy" -d shell/git shell/ssh >/dev/null
[ -f "$XDG_CONFIG_HOME/git/local.gitconfig" ]
[ -f "$XDG_CONFIG_HOME/ssh/local.conf" ]
[ -f "$GITHUB_ACCOUNTS_DIR/accounts/account-1.gitconfig" ]
[ ! -e "$XDG_CONFIG_HOME/git/config" ]
[ ! -e "$XDG_CONFIG_HOME/git/hooks/pre-push" ]
[ ! -e "$HOME/.ssh/config" ]

printf 'git-account unit tests passed\n'
