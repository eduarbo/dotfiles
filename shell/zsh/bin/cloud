#!/usr/bin/env bash

PROG=$0
RSYNC="/usr/bin/rsync"
SRC="/"
DST="mess"
HOST="${CLOUD_UPLOAD_HOST:-}"
DOMAIN="${CLOUD_UPLOAD_DOMAIN:-}"

# Header logging
e_header() {
  echo -e "\n$(tput setaf 7)$@$(tput sgr0)"
}

# Success logging
e_success() {
  echo "$(tput setaf 64)✓ $@$(tput sgr0)"
}

if [[ -z "$1" ]]; then
  echo "Usage: $PROG <file>"
  exit 1
fi

if [[ -z "$HOST" || -z "$DOMAIN" ]]; then
  echo "Set CLOUD_UPLOAD_HOST and CLOUD_UPLOAD_DOMAIN in your local shell config."
  exit 1
fi

if [[ ! -d "$1" && "$1" =~ \.(png|jpeg|jpg|gif|tiff|raw|bmp)$ ]]; then
  DST="screenshots"
fi

e_header "Uploading..."

$RSYNC -vax -S -H --delete --rsh='ssh -p2222' "$1" "$HOST/$DST"

e_success "Upload completed!"

echo "Link $DOMAIN/$DST/$(basename "$1") copied to pasteboard."
echo "$DOMAIN/$DST/$(basename "$1")" | pbcopy

exit 0
