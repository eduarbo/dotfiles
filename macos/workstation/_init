#!/usr/bin/env zsh
source ${0:A:h}/../../deploy

os=(macos)

deps=(
  macos/apps
  dev/agent-config
  dev/personal-ops
)

_workstation_postflight() {
  echo-note "Checking workstation readiness."
  ${0:A:h}/bin/workstation-doctor || return $?
  echo-ok "Automated workstation bootstrap is ready"
  echo-note "The doctor lists provider logins, macOS permissions, iCloud, Remote and iPhone readback as manual gates."
}

link() {
  mklink bin/workstation-doctor "${XDG_BIN_HOME:-$HOME/.local/bin}/workstation-doctor"
}

install() {
  _workstation_postflight
}

update() {
  local dependency
  echo-info "Updating workstation owners before postflight."
  for dependency in "${deps[@]}"; do
    "$DOTFILES/deploy" -f "$dependency" || return $?
  done
  _workstation_postflight
}

clean() {
  echo-note "Apps, repositories, authentication, and private state were preserved by their owner topics."
}

init "$@"
