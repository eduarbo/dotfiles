{
  "name": "karabiner-elements-config-generator",
  "version": "2.0.0",
  "description": "TypeScript-based Karabiner-Elements configuration generator",
  "type": "module",
  "main": "dist/config/karabiner.js",
  "scripts": {
    "build": "tsc && node --enable-source-maps dist/scripts/build.js json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prettier": "prettier config lib scripts --write",
    "docs": "uvx --from keymap-drawer==0.23.0 keymap draw docs/macbook.yaml -o docs/macbook.svg"
  },
  "keywords": [
    "karabiner-elements",
    "karabiner",
    "json",
    "typescript",
    "keyboard"
  ],
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@types/node": "^22.20.0",
    "prettier": "3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
